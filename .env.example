# Copy to .env (repo root) for `docker compose up`. Never commit real values.
APP_VERSION=dev
POSTGRES_PASSWORD=postgres
JWT_SECRET=change-me-to-a-long-random-string
# Secure cookies need HTTPS; keep false for plain HTTP (localhost or a VM without TLS).
COOKIE_SECURE=false
# true on the first start to create the demo users; false afterwards.
SEED_ON_START=false
SEED_USER_PASSWORD=change-me
SEED_ADMIN_PASSWORD=change-me
